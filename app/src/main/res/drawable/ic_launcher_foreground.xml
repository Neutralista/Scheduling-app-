<?xml version="1.0" encoding="utf-8"?>
<!--
    Waypoint adaptive icon foreground — 108×108dp canvas, safe zone 18–90dp.
    Design: classic compass rose in barley gold on a deep-plum background.

    Structure:
      • Outer bezel ring     (radius 29.5dp, gold stroke)
      • 4 intercardinal petals (NE/SE/SW/NW, radius 18dp, medium gold)
      • 4 cardinal petals    (N/E/S/W, radius 27dp, two-tone gold for depth)
      • Inner ring           (radius 8dp, gold stroke)
      • Centre dot           (radius 4dp, bright gold)
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer bezel ring -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#D4A84E"
        android:strokeWidth="1.1"
        android:pathData="M54,24.5 A29.5,29.5 0 1,1 54,83.5 A29.5,29.5 0 1,1 54,24.5" />

    <!-- ── Intercardinal petals (underneath the cardinal ones) ──────── -->

    <group android:pivotX="54" android:pivotY="54" android:rotation="45">
        <path android:fillColor="#C4912C"
              android:pathData="M54,36 L50,54 L54,59 L58,54 Z" />
    </group>
    <group android:pivotX="54" android:pivotY="54" android:rotation="135">
        <path android:fillColor="#C4912C"
              android:pathData="M54,36 L50,54 L54,59 L58,54 Z" />
    </group>
    <group android:pivotX="54" android:pivotY="54" android:rotation="225">
        <path android:fillColor="#C4912C"
              android:pathData="M54,36 L50,54 L54,59 L58,54 Z" />
    </group>
    <group android:pivotX="54" android:pivotY="54" android:rotation="315">
        <path android:fillColor="#C4912C"
              android:pathData="M54,36 L50,54 L54,59 L58,54 Z" />
    </group>

    <!-- ── Cardinal petals — two-tone (light west face / dark east face) -->
    <!-- North -->
    <path android:fillColor="#E8BE5A"
          android:pathData="M54,27 L47,54 L54,61 Z" />
    <path android:fillColor="#9C6A0E"
          android:pathData="M54,27 L61,54 L54,61 Z" />

    <!-- East (N petal rotated 90°) -->
    <group android:pivotX="54" android:pivotY="54" android:rotation="90">
        <path android:fillColor="#E8BE5A"
              android:pathData="M54,27 L47,54 L54,61 Z" />
        <path android:fillColor="#9C6A0E"
              android:pathData="M54,27 L61,54 L54,61 Z" />
    </group>

    <!-- South (180°) -->
    <group android:pivotX="54" android:pivotY="54" android:rotation="180">
        <path android:fillColor="#E8BE5A"
              android:pathData="M54,27 L47,54 L54,61 Z" />
        <path android:fillColor="#9C6A0E"
              android:pathData="M54,27 L61,54 L54,61 Z" />
    </group>

    <!-- West (270°) -->
    <group android:pivotX="54" android:pivotY="54" android:rotation="270">
        <path android:fillColor="#E8BE5A"
              android:pathData="M54,27 L47,54 L54,61 Z" />
        <path android:fillColor="#9C6A0E"
              android:pathData="M54,27 L61,54 L54,61 Z" />
    </group>

    <!-- Inner ring -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#D4A84E"
        android:strokeWidth="0.9"
        android:pathData="M54,46 A8,8 0 1,1 54,62 A8,8 0 1,1 54,46" />

    <!-- Centre dot -->
    <path
        android:fillColor="#F0C870"
        android:pathData="M54,50 A4,4 0 1,1 54,58 A4,4 0 1,1 54,50" />

</vector>
