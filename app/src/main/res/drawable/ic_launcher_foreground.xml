<?xml version="1.0" encoding="utf-8"?>
<!--
    Android color format is AARRGGBB (alpha first).
    Minimal compass rose: 4 symmetric diamond petals, gradient tip → base,
    small center hub. No rings, no glow overlays, no intercardinal petals.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- North — primary petal (brightest, tip at y=18) -->
    <path android:pathData="M54,18 L46,54 L54,64 L62,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear"
                android:startX="54" android:startY="18"
                android:endX="54"   android:endY="64"
                android:startColor="#FADA70"
                android:endColor="#A87820" />
        </aapt:attr>
    </path>

    <!-- South (180°) — same geometry, muted palette -->
    <group android:pivotX="54" android:pivotY="54" android:rotation="180">
        <path android:pathData="M54,18 L46,54 L54,64 L62,54 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear"
                    android:startX="54" android:startY="18"
                    android:endX="54"   android:endY="64"
                    android:startColor="#C49028"
                    android:endColor="#6A4A0A" />
            </aapt:attr>
        </path>
    </group>

    <!-- East (90°) -->
    <group android:pivotX="54" android:pivotY="54" android:rotation="90">
        <path android:pathData="M54,18 L46,54 L54,64 L62,54 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear"
                    android:startX="54" android:startY="18"
                    android:endX="54"   android:endY="64"
                    android:startColor="#DEB040"
                    android:endColor="#7E5610" />
            </aapt:attr>
        </path>
    </group>

    <!-- West (270°) -->
    <group android:pivotX="54" android:pivotY="54" android:rotation="270">
        <path android:pathData="M54,18 L46,54 L54,64 L62,54 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear"
                    android:startX="54" android:startY="18"
                    android:endX="54"   android:endY="64"
                    android:startColor="#DEB040"
                    android:endColor="#7E5610" />
            </aapt:attr>
        </path>
    </group>

    <!-- Center hub: dark fill + gold ring -->
    <path android:fillColor="#160A16"
          android:pathData="M54,49 A5,5 0 1,1 54,59 A5,5 0 1,1 54,49" />
    <path android:fillColor="#00000000"
          android:strokeColor="#D4A848"
          android:strokeWidth="1.8"
          android:pathData="M54,49 A5,5 0 1,1 54,59 A5,5 0 1,1 54,49" />

</vector>
