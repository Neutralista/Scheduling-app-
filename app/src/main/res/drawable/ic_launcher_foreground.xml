<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ambient golden glow behind the rose -->
    <path android:pathData="M54,54 m-28,0 a28,28 0 1,0 56,0 a28,28 0 1,0 -56,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="0.5"
                android:gradientRadius="28"
                android:startColor="#C8850030"
                android:endColor="#C8850000" />
        </aapt:attr>
    </path>

    <!-- Outer bezel ring (glowing) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#D4A84E60"
        android:strokeWidth="3.5"
        android:pathData="M54,23.5 A30.5,30.5 0 1,1 54,84.5 A30.5,30.5 0 1,1 54,23.5" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#D4A84E"
        android:strokeWidth="1.1"
        android:pathData="M54,23.5 A30.5,30.5 0 1,1 54,84.5 A30.5,30.5 0 1,1 54,23.5" />

    <!-- ── Intercardinal petals ── -->
    <group android:pivotX="54" android:pivotY="54" android:rotation="45">
        <path android:fillColor="#CD9E2A"
              android:pathData="M54,35 L49,54 L54,59 L59,54 Z" />
    </group>
    <group android:pivotX="54" android:pivotY="54" android:rotation="135">
        <path android:fillColor="#CD9E2A"
              android:pathData="M54,35 L49,54 L54,59 L59,54 Z" />
    </group>
    <group android:pivotX="54" android:pivotY="54" android:rotation="225">
        <path android:fillColor="#CD9E2A"
              android:pathData="M54,35 L49,54 L54,59 L59,54 Z" />
    </group>
    <group android:pivotX="54" android:pivotY="54" android:rotation="315">
        <path android:fillColor="#CD9E2A"
              android:pathData="M54,35 L49,54 L54,59 L59,54 Z" />
    </group>

    <!-- ── Cardinal petals — gradient tip-to-base + light/shadow overlay ── -->
    <!-- North: base fill -->
    <path android:pathData="M54,25.5 L46,54 L54,60.5 L62,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear"
                android:startX="54" android:startY="25.5"
                android:endX="54"   android:endY="60.5"
                android:startColor="#F2CC58"
                android:endColor="#9A6812" />
        </aapt:attr>
    </path>
    <!-- North: light face -->
    <path android:fillColor="#F8DC8040"
          android:pathData="M54,25.5 L46,54 L54,60.5 Z" />
    <!-- North: shadow face -->
    <path android:fillColor="#00000030"
          android:pathData="M54,25.5 L62,54 L54,60.5 Z" />

    <!-- East -->
    <group android:pivotX="54" android:pivotY="54" android:rotation="90">
        <path android:pathData="M54,25.5 L46,54 L54,60.5 L62,54 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear"
                    android:startX="54" android:startY="25.5"
                    android:endX="54"   android:endY="60.5"
                    android:startColor="#F2CC58"
                    android:endColor="#9A6812" />
            </aapt:attr>
        </path>
        <path android:fillColor="#F8DC8040"
              android:pathData="M54,25.5 L46,54 L54,60.5 Z" />
        <path android:fillColor="#00000030"
              android:pathData="M54,25.5 L62,54 L54,60.5 Z" />
    </group>

    <!-- South -->
    <group android:pivotX="54" android:pivotY="54" android:rotation="180">
        <path android:pathData="M54,25.5 L46,54 L54,60.5 L62,54 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear"
                    android:startX="54" android:startY="25.5"
                    android:endX="54"   android:endY="60.5"
                    android:startColor="#F2CC58"
                    android:endColor="#9A6812" />
            </aapt:attr>
        </path>
        <path android:fillColor="#F8DC8040"
              android:pathData="M54,25.5 L46,54 L54,60.5 Z" />
        <path android:fillColor="#00000030"
              android:pathData="M54,25.5 L62,54 L54,60.5 Z" />
    </group>

    <!-- West -->
    <group android:pivotX="54" android:pivotY="54" android:rotation="270">
        <path android:pathData="M54,25.5 L46,54 L54,60.5 L62,54 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear"
                    android:startX="54" android:startY="25.5"
                    android:endX="54"   android:endY="60.5"
                    android:startColor="#F2CC58"
                    android:endColor="#9A6812" />
            </aapt:attr>
        </path>
        <path android:fillColor="#F8DC8040"
              android:pathData="M54,25.5 L46,54 L54,60.5 Z" />
        <path android:fillColor="#00000030"
              android:pathData="M54,25.5 L62,54 L54,60.5 Z" />
    </group>

    <!-- Inner ring -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#D4A84E"
        android:strokeWidth="0.9"
        android:pathData="M54,45.5 A8.5,8.5 0 1,1 54,62.5 A8.5,8.5 0 1,1 54,45.5" />

    <!-- Centre dot -->
    <path android:fillColor="#FFE878"
          android:pathData="M54,49.5 A4.5,4.5 0 1,1 54,58.5 A4.5,4.5 0 1,1 54,49.5" />
    <!-- Centre highlight -->
    <path android:fillColor="#FFF8C0"
          android:pathData="M54,51.5 A2,2 0 1,1 54,55.5 A2,2 0 1,1 54,51.5" />

</vector>
