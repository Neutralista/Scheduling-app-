<?xml version="1.0" encoding="utf-8"?>
<!--
    Status-bar/notification small icon. Must stay a single flat white silhouette — Android
    strips any color info from this drawable and renders only its alpha shape, tinted by the
    system. A simplified 4-point compass-rose star, echoing the launcher icon's compass motif
    (see ic_launcher_foreground.xml) reduced to a bold shape that stays legible at 24dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,2 L14.5,9.5 L22,12 L14.5,14.5 L12,22 L9.5,14.5 L2,12 L9.5,9.5 Z" />
</vector>
